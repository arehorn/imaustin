---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import CareerLine from "../components/CareerLine.astro";
import ActTrust from "../components/ActTrust.astro";
import ActSystems from "../components/ActSystems.astro";
import ActBuilder from "../components/ActBuilder.astro";
import OffClock from "../components/OffClock.astro";
import Connect from "../components/Connect.astro";
import { imageUrl } from "../lib/sanity";
import { formatTags } from "../lib/utils";
import {
  HERO_QUERY,
  EXPERIENCE_ROLES_QUERY,
  PROJECTS_QUERY,
  CONNECT_QUERY,
  CONTACT_ITEMS_QUERY,
} from "../lib/queries";
import type {
  HeroData,
  ProjectItem,
  ExperienceRole,
  ContactItem,
} from "../types/emdash";

const client = sanityClient;

// One round trip, then reshape into the shapes the components expect.
const BATCHED_QUERY = `{
  "hero": ${HERO_QUERY},
  "roles": ${EXPERIENCE_ROLES_QUERY},
  "projects": ${PROJECTS_QUERY},
  "connect": ${CONNECT_QUERY},
  "contactItems": ${CONTACT_ITEMS_QUERY}
}`;

const data = await client.fetch<any>(BATCHED_QUERY);

const hero: HeroData = {
  headshot_url: imageUrl(data?.hero?.headshot, { width: 1000, quality: 85 }),
  headshot_alt: data?.hero?.headshotAlt ?? "",
  resume_url: data?.hero?.resumeUrl ?? "",
};

const roles: ExperienceRole[] = (data?.roles ?? []).map((r: any) => ({
  id: r._id,
  title: r.title,
  company: r.company,
  division: r.division ?? "",
  dates: r.dates ?? "",
  highlights: r.highlights ?? [],
}));

// The story splits by chapter, not by CMS order: Trust runs 2011–2021,
// Systems runs 2021–2026, so the career line reads chronologically.
const roleById = new Map(roles.map((role) => [role.id, role]));

function pickRoles(ids: string[], fallback: ExperienceRole[]) {
  const found = ids
    .map((id) => roleById.get(id))
    .filter((role): role is ExperienceRole => Boolean(role));
  return found.length > 0 ? found : fallback;
}

const trustRoles = pickRoles(["role-grg-ae", "role-grg-ops"], roles.slice(0, 2));
const systemsRoles = pickRoles(
  ["role-twiceasnice-scm", "role-rhodes-wolfe"],
  roles.slice(2),
);

const projects: ProjectItem[] = (data?.projects ?? []).map((p: any) => ({
  id: p._id,
  title: p.title,
  description: p.description ?? "",
  tags: formatTags(p.tags),
  href: p.href ?? "",
}));

const contactItems: ContactItem[] = (data?.contactItems ?? []).map((c: any) => ({
  id: c._id,
  label: c.label,
  value: c.value,
  href: c.href ?? "",
  icon_type: c.iconType ?? "email",
}));

const quote: string =
  data?.connect?.quote ??
  "If you're looking for someone who can own a relationship, build trust that drives referrals, and take initiative — let's talk.";
---

<Layout resumeUrl={hero.resume_url}>
  <main id="main-content">
    <Hero hero={hero} />
    <ProofStrip />

    <CareerLine>
      <ActTrust roles={trustRoles} />
      <ActSystems roles={systemsRoles} />
    </CareerLine>

    <div class="mx-auto max-w-6xl px-6 pt-24">
      <ActBuilder projects={projects} />
    </div>

    <OffClock />
    <Connect quote={quote} contactItems={contactItems} />
  </main>
</Layout>
