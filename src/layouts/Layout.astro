---
import "../styles/globals.css";
import Nav from "../components/Nav";
import { sanityClient } from "sanity:client";
import { HERO_QUERY } from "../lib/queries";

interface Props {
  title?: string;
  description?: string;
  /** Pass the hero's résumé URL when the page has already fetched it. */
  resumeUrl?: string;
}
const {
  title = "Austin Rehorn — Trust first. Then systems.",
  description = "Enterprise account manager and AI builder in Mt. Pleasant, SC. Fifteen years earning trust, then building the systems that make it scale.",
  resumeUrl: providedResumeUrl,
} = Astro.props;

const currentYear = new Date().getFullYear();

// Pages that already fetched the hero document hand us its URL; pages that
// didn't (the blog) still need one fetch to keep the nav link working.
const resumeUrl: string =
  providedResumeUrl ??
  ((await sanityClient.fetch<any>(HERO_QUERY))?.resumeUrl ?? "");
---

<!doctype html>
<html lang="en" class="h-full antialiased" data-path="curious">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800,900&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Restore the visitor's chosen door before first paint so the page
      // doesn't flash the default weighting.
      try {
        var path = sessionStorage.getItem("imaustin.path");
        if (path === "hiring" || path === "build" || path === "curious") {
          document.documentElement.dataset.path = path;
        }
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-full flex-col bg-[#0E0C09] text-[#F4F0E8] selection:bg-[#FF5A1F] selection:text-[#0E0C09]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-[#0E0C09] focus:text-[#FF5A1F]">Skip to main content</a>
    <!-- Warm ambient light -->
    <div class="nebula-bg pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>
    <!-- Grain texture overlay -->
    <div class="grain-overlay pointer-events-none fixed inset-0 z-0 opacity-[0.07]" aria-hidden="true"></div>

    <div class="relative z-10 flex min-h-full flex-col">
      <Nav client:load resumeUrl={resumeUrl} />
      <slot />
      <footer class="relative w-full px-6 pb-16 pt-24">
        <div class="mx-auto flex max-w-6xl flex-col items-center space-y-7 border-t border-white/10 pt-14">
          <div class="font-display text-2xl font-black tracking-tighter text-white">
            AUSTIN{" "}<span class="bg-gradient-to-r from-[#FF5A1F] to-[#C9A86C] bg-clip-text text-transparent">REHORN</span>
          </div>
          <p class="max-w-sm text-center text-[10px] font-medium uppercase leading-loose tracking-[0.5em] text-gray-600">
            © {currentYear} Austin Rehorn. <span class="text-gray-400">Relationship first. Results always.</span>
          </p>
        </div>
      </footer>
    </div>
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
