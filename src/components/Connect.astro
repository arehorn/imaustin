---
import type { ContactItem } from "../types/emdash";
import ContactForm from "./ContactForm";

interface Props {
  quote: string;
  contactItems: ContactItem[];
}

const { quote, contactItems } = Astro.props;

const CONTACT_ICON_PATHS: Record<string, string> = {
  email: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  linkedin: "M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z",
  location: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
};
---

<section id="connect" class="scroll-mt-28 py-28">
  <div class="mx-auto max-w-6xl px-6">
    <header class="max-w-2xl">
      <p class="act-kicker">Let&apos;s connect</p>
      <h2 class="act-title">The next chapter usually starts with a conversation.</h2>
    </header>

    <blockquote class="mt-10 max-w-3xl border-l-2 border-[#C9A86C]/50 pl-6 font-display text-lg font-medium leading-snug tracking-tight text-gray-200 sm:text-xl">
      {quote}
    </blockquote>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <aside class="path-only" data-path-for="hiring">
          <p class="path-note path-note-lg">
            Send the role, the team, and what a win looks like in the first 90 days. I&apos;ll tell
            you honestly whether I&apos;m the right person for it.
          </p>
        </aside>
        <aside class="path-only" data-path-for="build">
          <p class="path-note path-note-lg">
            Tell me what&apos;s slow, where it breaks, and who it hurts. If I can fix it, I&apos;ll
            say so. If I can&apos;t, I&apos;ll say that too.
          </p>
        </aside>
        <aside class="path-only" data-path-for="curious">
          <p class="path-note path-note-lg">
            No agenda needed. Tell me what you&apos;re working on and I&apos;ll tell you what
            I&apos;d do with it.
          </p>
        </aside>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {
            contactItems.map((item) => {
              const iconPath = CONTACT_ICON_PATHS[item.icon_type] ?? CONTACT_ICON_PATHS.email;
              return (
                <div class="glass-card flex items-center gap-4 rounded-2xl p-5">
                  <div class="glass-inset flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/5">
                    <svg class="h-5 w-5 glow-purple" fill="none" stroke="#C9A86C" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPath} />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-gray-500">{item.label}</p>
                    {item.href ? (
                      <a
                        href={item.href}
                        target={item.href.startsWith("http") ? "_blank" : undefined}
                        rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                        class="mt-1 block break-words text-sm font-bold text-white transition-colors hover:text-[#FF5A1F]"
                      >
                        {item.value}
                      </a>
                    ) : (
                      <p class="mt-1 break-words text-sm font-bold text-white">{item.value}</p>
                    )}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <ContactForm client:visible />
    </div>
  </div>
</section>
