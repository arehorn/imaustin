---
import type { HeroData } from "../types/emdash";
import PathChooser from "./PathChooser";

interface Props {
  hero: HeroData;
}

const { hero } = Astro.props;
---

<section id="hero" class="relative overflow-hidden pb-16 pt-36 sm:pt-40">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="text-[11px] font-bold uppercase tracking-[0.32em] text-[#C9A86C]">
          Mt. Pleasant, SC · open to in-office, hybrid &amp; remote
        </p>

        <h1 class="mt-7 font-display font-black tracking-tighter text-white">
          <span class="line-mask text-[clamp(2.9rem,7.4vw,5.6rem)] leading-[0.95]">
            <span data-line>Trust first.</span>
          </span>
          <span class="line-mask text-[clamp(2.9rem,7.4vw,5.6rem)] leading-[0.95]">
            <span data-line class="text-gradient">Then systems.</span>
          </span>
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-gray-300 sm:text-xl">
          Fifteen years earning the kind of trust that turns clients into referrals — then
          building the AI workflows that let that trust scale. I&apos;m Austin Rehorn. I listen
          first, then I remove whatever is slowing you down.
        </p>

        <div class="mt-10">
          <PathChooser client:load />
        </div>

        {hero.resume_url && (
          <p class="mt-8 text-sm text-gray-500">
            Prefer the short version?{" "}
            <a
              href={hero.resume_url}
              download
              class="font-medium text-[#F4F0E8] underline decoration-[#C9A86C]/40 underline-offset-4 transition-colors hover:text-[#FF5A1F] hover:decoration-[#FF5A1F]"
            >
              Download the résumé
            </a>
          </p>
        )}
      </div>

      <div class="flex justify-center lg:col-span-5 lg:justify-end">
        <div class="relative w-full max-w-sm">
          <div
            class="absolute -inset-6 rounded-full bg-gradient-to-tr from-[#C9A86C]/25 to-[#FF5A1F]/25 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <figure
            class="art-frame relative aspect-[4/5] rotate-2 transition-transform duration-700 hover:rotate-0"
            data-portrait
          >
            <img
              src={hero.headshot_url}
              alt={hero.headshot_alt || "Austin Rehorn"}
              width="480"
              height="600"
              class="h-full w-full object-cover object-top brightness-95 contrast-105"
              loading="eager"
            />
          </figure>
          <figcaption class="mt-4 text-right text-[10px] uppercase tracking-[0.28em] text-gray-500">
            Austin Rehorn · Mt. Pleasant, SC
          </figcaption>
        </div>
      </div>
    </div>
  </div>
</section>
