---
import type { ProjectItem } from '../types/emdash';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;

const ACCENT_CYCLE = [
  { from: "#FF5A1F", to: "#C9A86C", border: "hover:border-[#FF5A1F]/50" },
  { from: "#C9A86C", to: "#FF5A1F", border: "hover:border-[#C9A86C]/50" },
] as const;
---

<section id="work" class="relative py-28">
  <div class="max-w-7xl mx-auto px-6">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 border-l-4 border-[#FF5A1F] pl-8 mb-20">
      <div class="space-y-4">
        <span class="text-[#FF5A1F] font-bold uppercase tracking-[0.4em] text-xs">Featured Work</span>
        <h2 class="text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tighter">
          Signal in the noise.
        </h2>
      </div>
      <p class="text-gray-500 max-w-md italic text-lg">
        Projects where strategy met shipping.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 pt-6">
      {projects.map((project: ProjectItem, i: number) => {
        const accent = ACCENT_CYCLE[i % ACCENT_CYCLE.length];
        return (
          <div
            class={`staggered-item rounded-[2.5rem] p-10 glass-card flex flex-col group hover:-translate-y-4 transition-all duration-500 ${accent.border}`}
          >
            <div
              class="w-16 h-1.5 rounded-full mb-8"
              style={`background: linear-gradient(90deg, ${accent.from}, ${accent.to}); box-shadow: 0 0 15px ${accent.from}80;`}
            />

            <h3 class="font-display font-bold text-2xl mb-4 tracking-tighter text-white leading-tight">
              {project.title}
            </h3>
            <p class="text-base leading-relaxed mb-8 flex-1 text-gray-400">
              {project.description}
            </p>

            <div class="flex items-center justify-between gap-4 mt-auto pt-8">
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="tag-pill px-3 py-1.5 text-xs font-medium uppercase tracking-wider">
                    {tag}
                  </span>
                ))}
              </div>
              {project.href && (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} (opens in a new tab)`}
                  class="shrink-0 p-3 rounded-full glass-inset border border-white/10 text-white hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF5A1F]"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
